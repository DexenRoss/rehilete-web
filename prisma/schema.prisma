generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum PublicationKind {
  REVIEW
  SPECIAL
}

enum SpecialFormat {
  ARTICLE
  LIST
  COLLECTION
  FEATURE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PublicationReviewTier {
  RECOMENDADO
  FAVORITO
  ESENCIAL
}

model AdminUser {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  passwordHash        String
  role                AdminRole     @default(EDITOR)
  isActive            Boolean       @default(true)
  createdPublications Publication[] @relation("PublicationCreatedBy")
  updatedPublications Publication[] @relation("PublicationUpdatedBy")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Publication {
  id               String            @id @default(cuid())
  kind             PublicationKind
  status           PublicationStatus @default(DRAFT)
  title            String
  slug             String            @unique
  subtitle         String?
  description      String?
  body             String
  coverImageUrl    String?
  coverImageAlt    String?
  year             Int?
  rating           Float?
  reviewTier       PublicationReviewTier?
  specialFormat    SpecialFormat?
  workType         String?
  externalUrl      String?
  categoryId       String?
  reviewerId       String?
  subjectCreatorId String?
  createdById      String?
  updatedById      String?
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviewer         Contributor?      @relation("PublicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  subjectCreator   SubjectCreator?   @relation("PublicationSubjectCreator", fields: [subjectCreatorId], references: [id], onDelete: SetNull)
  createdBy        AdminUser?        @relation("PublicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        AdminUser?        @relation("PublicationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tags             PublicationTag[]

  @@index([kind, status])
  @@index([categoryId])
  @@index([reviewerId])
  @@index([subjectCreatorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([publishedAt])
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  publications Publication[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Contributor {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  bio          String?
  imageUrl     String?
  publications Publication[] @relation("PublicationReviewer")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SubjectCreator {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  bio          String?
  imageUrl     String?
  publications Publication[] @relation("PublicationSubjectCreator")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Tag {
  id           String           @id @default(cuid())
  name         String           @unique
  slug         String           @unique
  publications PublicationTag[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model PublicationTag {
  publicationId String
  tagId         String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([publicationId, tagId])
  @@index([tagId])
}
